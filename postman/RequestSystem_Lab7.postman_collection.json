{
  "info": {
    "name": "RequestSystem — ЛР7 REST API",
    "description": "16 запросов для проверки API. Сначала запустите сервер. Запускайте сверху вниз; ID новой заявки сохраняется в requestId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "requestId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json()).to.be.an('array');"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Statuses",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/statuses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json()).to.be.an('array');"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json()).to.be.an('array');"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Request list",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/requests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json()).to.be.an('array');"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Create request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"ЛР7: заявка из Postman\",\n  \"description\": \"Тестовая заявка для проверки REST API\",\n  \"user_id\": 1,\n  \"category_id\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const d=pm.response.json();",
              "pm.expect(d.request_id).to.be.a('number');",
              "pm.collectionVariables.set('requestId', d.request_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Get request by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/requests/{{requestId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().request_id).to.eql(Number(pm.collectionVariables.get('requestId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Search",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/requests?search=принтер"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json()).to.be.an('array');"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Filter status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/requests?status_id=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().every(x=>x.status_id===1)).to.eql(true);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Filter category",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/requests?category_id=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().every(x=>x.category_id===1)).to.eql(true);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Update request",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/requests/{{requestId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"ЛР7: заявка обновлена\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().title).to.eql('ЛР7: заявка обновлена');"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Change status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/requests/{{requestId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status_id\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().status_id).to.eql(2);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Invalid request data — expect 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"x\",\n  \"description\": \"\",\n  \"user_id\": 1,\n  \"category_id\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 validation error', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Missing request — expect 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/requests/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 not found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Delete created request",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/requests/{{requestId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 no content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Verify deleted request — expect 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/requests/{{requestId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 after delete', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}